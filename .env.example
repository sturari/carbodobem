# Modelo de configuração. Para rodar localmente, copie para .env.local e preencha.
# Em produção, cadastre estas variáveis na Vercel:
#   Projeto → Settings → Environment Variables.
# Nunca commite segredos (tudo abaixo de "Segredos").

# === Supabase (públicas — podem ficar no .env commitado) ===
# Supabase → Project Settings → API / Data API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ============================== Segredos ==============================

# === Supabase (servidor) ===
# Chave secreta / service_role: só no servidor (Vercel). NUNCA no .env commitado.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres para migrações via drizzle-kit (opcional).
DATABASE_URL=

# === Mercado Pago ===
# Chaves de produção (obrigatórias) e de teste (opcional, para sandbox).
# Obter em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN_PROD=
MERCADOPAGO_PUBLIC_KEY_PROD=
MERCADOPAGO_ACCESS_TOKEN_TEST=
MERCADOPAGO_PUBLIC_KEY_TEST=
# Segredo da assinatura x-signature do webhook
MERCADOPAGO_WEBHOOK_SECRET=

# === E-mail transacional (Resend) ===
# https://resend.com/api-keys — permissão "Full access" (o status do envio lê a lista de e-mails).
RESEND_API_KEY=
# Opcional: domínio remetente verificado no Resend (padrão: notify.carbodobem.com.br)
EMAIL_FROM_DOMAIN=

# === Rotina de manutenção de pedidos ===
# A Vercel Cron envia "Authorization: Bearer <CRON_SECRET>" automaticamente.
# Para chamada manual: header x-cron-secret na rota /api/public/cron/pedidos
CRON_SECRET=

# === URL pública base (success/failure/pending e webhook) ===
PUBLIC_APP_URL=http://localhost:8080

# === Atalho de desenvolvimento (?dev=1 no checkout) ===
# Só afeta o ambiente local; não usar dados reais.
VITE_DEV_NOME=
VITE_DEV_EMAIL=
VITE_DEV_TELEFONE=
VITE_DEV_CPF=
