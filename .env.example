# Modelo de configuração local. Copie para .env e preencha.
# O .env NAO deve ir para o repositório (está no .gitignore).
# Em produção as chaves ficam no Lovable Cloud (secrets), não em arquivos.

# === Lovable Cloud (banco) — preenchidas automaticamente ===
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# === Mercado Pago ===
# Chaves de produção (obrigatórias) e de teste (opcional, para sandbox).
# Obter em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN_PROD=
MERCADOPAGO_PUBLIC_KEY_PROD=
MERCADOPAGO_ACCESS_TOKEN_TEST=
MERCADOPAGO_PUBLIC_KEY_TEST=
# Segredo da assinatura x-signature do webhook
MERCADOPAGO_WEBHOOK_SECRET=

# === E-mail transacional (provedor gerenciado Lovable) ===
# LOVABLE_API_KEY é gerenciado pelo Lovable e não deve ser copiado aqui.
# LOVABLE_SEND_URL é opcional (endpoint de envio; tem padrão interno).
LOVABLE_SEND_URL=

# === Rotina de manutenção de pedidos ===
# Header x-cron-secret da rota /api/public/cron/pedidos
CRON_SECRET=
# Mesmo valor, usado pelo agendamento interno (pg_cron)
CRON_JOB_SECRET=

# === URL pública base (success/failure/pending e webhook) ===
PUBLIC_APP_URL=http://localhost:8080

# === Atalho de desenvolvimento (?dev=1 no checkout) ===
# Só afeta o ambiente local; não usar dados reais.
VITE_DEV_NOME=
VITE_DEV_EMAIL=
VITE_DEV_TELEFONE=
VITE_DEV_CPF=
